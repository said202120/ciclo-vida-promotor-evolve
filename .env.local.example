# Generado por la integración de Vercel + Supabase.
# Corre `vercel env pull .env.local` para obtenerlo automáticamente
# en vez de copiar valores a mano.
POSTGRES_URL="postgres://usuario:password@host:5432/postgres"

# Clave para firmar las cookies de sesión (login). Generar con:
#   openssl rand -base64 32
# Debe configurarse en Vercel (Production/Preview/Development) y aquí para
# probar el login en local — sin ella, nadie puede iniciar sesión.
AUTH_SECRET="pega-aqui-el-valor-generado"

# Alertas por correo (Resend).
RESEND_API_KEY=""
# Remitente — usa el dominio de pruebas de Resend hasta que verifiques el tuyo.
ALERTAS_FROM_EMAIL="Ciclo de vida del promotor <onboarding@resend.dev>"

# TEMPORAL, mientras el dominio no esté verificado en Resend: el sandbox solo
# entrega al dueño de la cuenta, así que todas las alertas se mandan aquí en
# vez de a los usuarios ejecutivo. Para revertir, borra esta variable en
# Vercel — no hace falta tocar código.
ALERTAS_OVERRIDE_EMAIL="said@evolve.com.mx"

# Protege /api/cron/check-alertas: Vercel manda automáticamente
# `Authorization: Bearer <CRON_SECRET>` en cada invocación programada cuando
# esta variable está configurada en el proyecto. Generar con:
#   openssl rand -base64 32
CRON_SECRET="pega-aqui-otro-valor-generado"
